# Copy to `.env` (gitignored) and fill in only what you use.
# Empty value = source disabled. Never commit `.env`.

# Shodan (optional, read-only lookups of already indexed data): https://account.shodan.io
SURFACEMAP_SHODAN_API_KEY=

# Censys Search (optional, read-only): https://search.censys.io/account/api
SURFACEMAP_CENSYS_API_ID=
SURFACEMAP_CENSYS_API_SECRET=

# Local SQLite cache directory (default: .cache)
# SURFACEMAP_CACHE_DIR=.cache
